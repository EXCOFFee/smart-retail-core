{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2024",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/scripts",
    "rootDir": ".",
    "types": ["node"],
    "noImplicitAny": false
  },
  "include": ["./**/*.ts"]
}
